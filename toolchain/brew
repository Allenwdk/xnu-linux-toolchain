#!/usr/bin/env bash
# Minimal Homebrew stand-in. The XNU build scripts ask for `brew --prefix
# <formula>` to locate LLVM tools; on Linux those live on the system prefix.
case "${1:-}" in
  --prefix)
    case "${2:-}" in
      llvm|llvm@*|lld|llvm*) echo /usr ;;
      *) echo /usr/local ;;
    esac;;
  *)
    echo "brew: only --prefix is supported on this host" >&2
    exit 1;;
esac
